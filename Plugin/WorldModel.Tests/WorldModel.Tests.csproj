<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Versions.props" />
  <!-- Tests the world model's pure core: the snapshot, the store's
       fail-closed modes and retire protocol, publish ordering against the
       recorder in Kerbcast.API.Testing, a threading stress run, and a
       command camera's framing radius across record handovers. Compiles
       the sources directly (no KSP/Unity). Run: `dotnet run`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <KerbcastVersionCode>$(KerbcastApiVersionCode)</KerbcastVersionCode>
    <!-- The ring's part records are filled only by the plugin's sampler. -->
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Kerbcast.API/**/*.cs" Exclude="../Kerbcast.API/obj/**;../Kerbcast.API/bin/**" />
    <Compile Include="../Kerbcast.API.Testing/**/*.cs" Exclude="../Kerbcast.API.Testing/obj/**;../Kerbcast.API.Testing/bin/**" />
    <Compile Include="../Kerbcast/WorldModelSnapshot.cs" />
    <Compile Include="../Kerbcast/Kinematics.cs" />
    <Compile Include="../Kerbcast/WorldModelStore.cs" />
    <Compile Include="../Kerbcast/TelemetryMeters.cs" />
    <Compile Include="../Kerbcast/CraftFixState.cs" />
    <Compile Include="../Kerbcast/CommandCameraMath.cs" />
    <Compile Include="../Kerbcast/SiteBindings.cs" />
    <Compile Include="../Kerbcast/CommandLock.cs" />
    <Compile Include="../Kerbcast/PastInstant.cs" />
    <Compile Include="../Kerbcast/LensSights.cs" />
    <Compile Include="../Kerbcast/LightHistory.cs" />
    <Compile Include="../Kerbcast/LightHistorySave.cs" />
    <Compile Include="../Kerbcast/LightHistoryMath.cs" />
  </ItemGroup>
</Project>
