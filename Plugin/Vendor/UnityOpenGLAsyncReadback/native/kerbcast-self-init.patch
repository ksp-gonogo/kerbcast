@@ -29,6 +29,33 @@ static std::mutex tasks_mutex;
 int next_event_id = 1;
 static bool inited = false;
 
+/* kerbcast (not upstream): Unity only calls UnityPluginLoad for plugins it
+   loads itself from its own Plugins folder. Kerbcast dlopens this library from
+   GameData, so GLEW is initialised here instead, lazily on the render thread
+   where the GL context is current. If the GL entry points still cannot be
+   resolved, every task fails with an error rather than calling a null pointer. */
+static int gl_state = 0; /* 0 untried, 1 ready, -1 unusable; render thread only */
+static bool EnsureGlReady() {
+	if (gl_state == 0) {
+		if (!inited) {
+			glewInit();
+		}
+		bool ok = glGenFramebuffers != nullptr && glFramebufferTexture != nullptr
+			&& glGenBuffers != nullptr && glBindBuffer != nullptr && glBufferData != nullptr
+			&& glCopyBufferSubData != nullptr && glFenceSync != nullptr
+			&& glGetSynciv != nullptr && glDeleteSync != nullptr
+			&& glMapBufferRange != nullptr && glUnmapBuffer != nullptr
+			&& glDeleteBuffers != nullptr && glDeleteFramebuffers != nullptr
+			&& glBindFramebuffer != nullptr;
+		gl_state = ok ? 1 : -1;
+	}
+	return gl_state == 1;
+}
+
+extern "C" int UNITY_INTERFACE_EXPORT UNITY_INTERFACE_API KerbcastGlState() {
+	return gl_state;
+}
