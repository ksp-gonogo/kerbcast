<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone unit test for InFlightReadbacks.cs, the Unity-free queue of a
    camera's pending readbacks, and CaptureCounters.cs, which reports how many
    frames they took to land. Run: `dotnet run`. Mirrors the ControlBlock.Tests
    / ShedController.Tests pattern.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Kerbcast/InFlightReadbacks.cs" />
    <Compile Include="../Kerbcast/CaptureCounters.cs" />
  </ItemGroup>

</Project>
