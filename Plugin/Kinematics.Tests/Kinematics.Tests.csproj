<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kerbcast's kinematics (conic, ballistic and surface propagation, the
       frame turn, uncertainty) against a transcription of KSP's own Orbit and
       CelestialBody maths. Compiles the sources directly (no KSP/Unity).
       Run: `dotnet run`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Kerbcast/Kinematics.cs" />
    <Compile Include="../Kerbcast/CommandCameraMath.cs" />
    <Compile Include="../Kerbcast/CraftFixState.cs" />
  </ItemGroup>
</Project>
