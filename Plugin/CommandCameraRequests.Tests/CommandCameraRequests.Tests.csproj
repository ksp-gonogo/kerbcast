<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone contract test for created command cameras: the vantage type,
       default feed names, wire ids and the client request file. Unity-free.
       Run: `dotnet run`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Kerbcast/CameraId.cs" />
    <Compile Include="../Kerbcast/CommandVantage.cs" />
    <Compile Include="../Kerbcast/CommandCameraRequests.cs" />
    <Compile Include="../Kerbcast/ChangeSignal.cs" />
  </ItemGroup>
</Project>
