<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone test for the light-time boundary: when a loaded craft is
       hidden and drawn at its past instant, and where its stand-in goes.
       Unity-free. Run: `dotnet run`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The ring's body records are filled only by the plugin. -->
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Kerbcast/PictureBoundary.cs" />
    <Compile Include="../Kerbcast/LightHistoryMath.cs" />
    <Compile Include="../Kerbcast/CommandCameraMath.cs" />
    <Compile Include="../Kerbcast/CraftFixState.cs" />
  </ItemGroup>
</Project>
