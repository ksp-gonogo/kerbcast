<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone test for the brightness and view cull: no craft it skips
       would have been drawn from its true past state, across destroy,
       recover, dock, break-up and an SOI change within the horizon.
       Unity-free. Run: `dotnet run`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The ring's part records are filled only by the plugin's sampler. -->
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Kerbcast/PictureCull.cs" />
    <Compile Include="../Kerbcast/PastInstant.cs" />
    <Compile Include="../Kerbcast/LightHistory.cs" />
    <Compile Include="../Kerbcast/LightHistorySave.cs" />
    <Compile Include="../Kerbcast/LightHistoryMath.cs" />
    <Compile Include="../Kerbcast/CommandCameraMath.cs" />
    <Compile Include="../Kerbcast/CraftFixState.cs" />
  </ItemGroup>
</Project>
