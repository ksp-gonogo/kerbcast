<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone unit test for SidecarArgs.cs, the sidecar's launch command
    line built from settings.cfg. Compiles only that file (no KSP/Unity
    assemblies needed). Run: `dotnet run`.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Kerbcast/SidecarArgs.cs" />
  </ItemGroup>

</Project>
