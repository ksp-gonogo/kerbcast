<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Loads libAsyncGPUReadbackPlugin.so through NativeReadbackLibrary from the
    GameData tree named by KERBCAST_GAMEDATA, and SKIPs when it is unset.
    Run: `KERBCAST_GAMEDATA=<GameData> dotnet run`.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Vendor/UnityOpenGLAsyncReadback/NativeReadbackLibrary.cs" />
  </ItemGroup>

</Project>
