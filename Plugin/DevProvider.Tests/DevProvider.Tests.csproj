<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Versions.props" />
  <!-- The development provider's case matrix: what it publishes under delay
       across dock, undock, destroy, recovery and a reused persistentId, and
       what Kerbcast's knowledge side resolves from it at each stamp.
       Compiles the provider's core, Kerbcast.API with its recorder, and
       Kerbcast's pure world-model core directly (no KSP/Unity).
       Run: `dotnet run`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <KerbcastVersionCode>$(KerbcastApiVersionCode)</KerbcastVersionCode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Kerbcast.API/**/*.cs" Exclude="../Kerbcast.API/obj/**;../Kerbcast.API/bin/**" />
    <Compile Include="../Kerbcast.API.Testing/**/*.cs" Exclude="../Kerbcast.API.Testing/obj/**;../Kerbcast.API.Testing/bin/**" />
    <Compile Include="../Kerbcast.DevProvider/DelayedTruth.cs" />
    <Compile Include="../Kerbcast.DevProvider/LockTenure.cs" />
    <Compile Include="../Kerbcast/WorldModelSnapshot.cs" />
    <Compile Include="../Kerbcast/Kinematics.cs" />
    <Compile Include="../Kerbcast/TelemetryMeters.cs" />
    <Compile Include="../Kerbcast/WorldModelStore.cs" />
    <Compile Include="../Kerbcast/CraftFixState.cs" />
    <Compile Include="../Kerbcast/CommandCameraMath.cs" />
    <Compile Include="../Kerbcast/SiteBindings.cs" />
  </ItemGroup>
</Project>
