<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone contract test for StationTerrainMath.cs and
       StationDetailMath.cs (stock's terrain subdivision rule as a station
       camera sees it, and the detail centres added to it). Run: `dotnet run`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Kerbcast/StationTerrainMath.cs" />
    <Compile Include="../Kerbcast/StationDetailMath.cs" />
  </ItemGroup>
</Project>
