<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone contract test for anchored markers: the anchor model and
       validation, the registry, the commands-file table, the frame metadata
       JSON, the status file's command track allowlist and the projection maths. Unity-free. Run: `dotnet run`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Kerbcast/Anchors.cs" />
    <Compile Include="../Kerbcast/CommandCameraMath.cs" />
    <Compile Include="../Kerbcast/CraftFixState.cs" />
    <Compile Include="../Kerbcast/CameraId.cs" />
    <Compile Include="../Kerbcast/CommandVantage.cs" />
    <Compile Include="../Kerbcast/CommandCameraRequests.cs" />
    <Compile Include="../Kerbcast/CommandFrameState.cs" />
  </ItemGroup>
</Project>
