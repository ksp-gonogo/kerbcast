<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone unit test for MmapFrameRing.cs — the Unity-free single-writer
    seqlock frame ring, plus the metadata encoder its fixture is written with
    (no KSP/Unity assemblies). Run:
    `dotnet run`. Mirrors the ControlBlock.Tests / ShedController.Tests pattern.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Kerbcast/MmapFrameRing.cs" />
    <!-- The metadata fixture is written by the plugin's own encoder. -->
    <Compile Include="../Kerbcast/CommandFrameState.cs" />
    <Compile Include="../Kerbcast/Anchors.cs" />
    <Compile Include="../Kerbcast/CommandCameraMath.cs" />
    <Compile Include="../Kerbcast/CraftFixState.cs" />
    <Compile Include="../Kerbcast/CameraId.cs" />
    <Compile Include="../Kerbcast/CommandVantage.cs" />
    <Compile Include="../Kerbcast/CommandCameraRequests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The cross-language golden ring; the Rust reader test consumes the
         same file. Copied next to the binary for the regen comparison. -->
    <None Include="../../sidecar/testdata/frame_ring_v2.ring"
          Link="frame_ring_v2.ring"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../sidecar/testdata/frame_ring_v2_meta.ring"
          Link="frame_ring_v2_meta.ring"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
